# PostgreSQL container
POSTGRES_DB=clipsync
POSTGRES_USER=clipsync
POSTGRES_PASSWORD=clipsync
POSTGRES_PORT=5433

# Backend
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/clipsync
DB_USERNAME=clipsync
DB_PASSWORD=clipsync
ROOM_TTL=PT24H
CLEANUP_INTERVAL=PT10M
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend settings live in frontend/.env (see frontend/.env.example).
